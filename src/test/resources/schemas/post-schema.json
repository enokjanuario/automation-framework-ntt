{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Post Response Schema",
  "description": "Schema for JSONPlaceholder Post API response",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "userId": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
